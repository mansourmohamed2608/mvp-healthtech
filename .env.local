NODE_ENV=development
PORT=3001
INTERNAL_SECRET=dev-internal-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me
WS_SHARED_SECRET=dev-ws-secret

# Service URLs (local)
ASR_SERVICE_URL=http://localhost:5000
LLM_SERVICE_URL=http://localhost:5001
TTS_SERVICE_URL=http://localhost:5002
SOAP_SERVICE_URL=http://localhost:5003
FHIR_SERVICE_URL=http://localhost:5004
ORCHESTRATOR_URL=http://localhost:5006
CLINICAL_LLM_URL=http://localhost:5001
VA_LLM_URL=http://localhost:5007
FHIR_BASE_URL=http://localhost:5004

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Postgres (adjust to your local setup)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthtech
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthtech

# Twilio (dev placeholders; not needed for VA HTTP smoke)
TWILIO_ACCOUNT_SID=dev-twilio-sid
TWILIO_AUTH_TOKEN=dev-twilio-token
TWILIO_API_KEY=dev-twilio-api-key
TWILIO_API_KEY_SID=dev-twilio-api-key-sid
TWILIO_API_SECRET=dev-twilio-api-secret
TWILIO_TWIML_APP_SID=dev-twilio-app
GATEWAY_PUBLIC_URL=http://localhost:3001

# Voice agent toggle
VOICE_AGENT_LLM_ENABLED=1

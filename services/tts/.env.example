# TTS Service (.env placeholders — rotate all real secrets)

PORT=5002
NODE_ENV=development

JWT_SECRET=REPLACE_ME_JWT_SECRET
INTERNAL_SECRET=REPLACE_ME_INTERNAL_SECRET
WS_SHARED_SECRET=REPLACE_ME_WS_SHARED_SECRET

# Service URLs (docker network)
ASR_SERVICE_URL=http://asr:5000
LLM_SERVICE_URL=http://llm-clinical:5001
TTS_SERVICE_URL=http://tts:5002
SOAP_SERVICE_URL=http://soap:5003
FHIR_SERVICE_URL=http://fhir:5004
ORCHESTRATOR_URL=http://orchestrator:5006

# HuggingFace / models
HF_TOKEN=REPLACE_ME_HF_TOKEN
WHISPER_MODEL=large-v3
DEVICE=cpu
COMPUTE_TYPE=float32

# Twilio (placeholders)
TWILIO_ACCOUNT_SID=REPLACE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_ME_TWILIO_AUTH_TOKEN
TWILIO_API_KEY=REPLACE_ME_TWILIO_API_KEY
TWILIO_API_KEY_SID=REPLACE_ME_TWILIO_API_KEY_SID
TWILIO_API_SECRET=REPLACE_ME_TWILIO_API_SECRET
TWILIO_TWIML_APP_SID=REPLACE_ME_TWILIO_TWIML_APP_SID

# DB / Cache
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
REDIS_HOST=redis
REDIS_PORT=6379

# FHIR
FHIR_BASE_URL=https://fhir.dev-sandbox.local
FHIR_BEARER_TOKEN=REPLACE_ME_FHIR_BEARER_TOKEN
FHIR_CLIENT_ID=REPLACE_ME_FHIR_CLIENT_ID
FHIR_CLIENT_SECRET=REPLACE_ME_FHIR_CLIENT_SECRET
FHIR_BASIC_AUTH_USER=REPLACE_ME_FHIR_BASIC_USER
FHIR_BASIC_AUTH_PASSWORD=REPLACE_ME_FHIR_BASIC_PASSWORD

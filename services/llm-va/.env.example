# VA LLM Service (.env placeholders — rotate all real secrets)

PORT=5007
NODE_ENV=development

VA_MODEL=Qwen/Qwen2.5-3B-Instruct
VA_DEVICE=cpu
VA_DTYPE=float16
VA_MAX_CONCURRENCY=4
INTERNAL_SECRET=REPLACE_ME_INTERNAL_SECRET
JWT_SECRET=REPLACE_ME_JWT_SECRET

# Optional model/runtime tuning
VA_QUANT=8bit

# =============================================================================
# HealthTech MVP - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-use-strong-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Twilio Configuration (Voice Agent)
# -----------------------------------------------------------------------------
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_API_KEY_SID=your_api_key_sid_here
TWILIO_API_KEY_SECRET=your_api_key_secret_here
TWILIO_PHONE_NUMBER=+1234567890

# Public URL where Twilio can reach your gateway (use ngrok for local dev)
GATEWAY_PUBLIC_URL=https://your-domain.ngrok.io

# -----------------------------------------------------------------------------
# Microservices URLs
# -----------------------------------------------------------------------------
# ASR (Automatic Speech Recognition) Service
ASR_SERVICE_URL=http://localhost:5000
# ASR_SERVICE_URL=http://asr:5000  # Use this in Docker Compose

# LLM (Large Language Model) Service  
LLM_SERVICE_URL=http://localhost:5001
# LLM_SERVICE_URL=http://llm:5001  # Use this in Docker Compose

# TTS (Text-to-Speech) Service
TTS_SERVICE_URL=http://localhost:5002
# TTS_SERVICE_URL=http://tts:5002  # Use this in Docker Compose

# SOAP Note Generator Service (Week 4)
SOAP_SERVICE_URL=http://localhost:5003
# SOAP_SERVICE_URL=http://soap:5003  # Use this in Docker Compose

# -----------------------------------------------------------------------------
# Twilio Configuration (Additional - Week 4)
# -----------------------------------------------------------------------------
# For voice client web UI
TWILIO_TWIML_APP_SID=your_twiml_app_sid_here
NEXT_PUBLIC_TWILIO_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL (for sessions, clinical notes)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=healthtech
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=healthtech_mvp

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis Configuration (for caching, session store, conversation history)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Observability & Monitoring
# -----------------------------------------------------------------------------
# Prometheus metrics endpoint enabled
METRICS_ENABLED=true

# Logging level (error, warn, info, debug, verbose)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# ML Model Paths (for local development)
# -----------------------------------------------------------------------------
# Path to Whisper LoRA adapters (trained on Kaggle)
WHISPER_LORA_PATH=./services/asr/lora_ckpt

# Path to LLM model cache
TRANSFORMERS_CACHE=./cache/transformers

# Hugging Face token (optional, for private models)
HF_TOKEN=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# CORS Settings
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3001

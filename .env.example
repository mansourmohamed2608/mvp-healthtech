# =============================================================================
# HealthTech AI — Environment Variables Reference
# Copy to .env.  Use a secrets manager (Vault / AWS SSM / Azure Key Vault) in
# production — never commit a populated .env file to version control.
#
# Deploy with:
#   docker compose -f infra/docker-compose.prod.yml --env-file .env up -d
# =============================================================================

# ─── DATABASE ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=                      # REQUIRED — strong random password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/healthtech

# ─── SECRETS ──────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
JWT_SECRET=                             # REQUIRED
REFRESH_TOKEN_SECRET=                   # REQUIRED — must differ from JWT_SECRET
INTERNAL_SECRET=                        # REQUIRED — shared by gateway + services
WS_SHARED_SECRET=

# ─── SEED USER (seed-init container — runs once on first deploy) ──────────────
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=                    # REQUIRED — strong password
SEED_ADMIN_ROLES=admin,clinician
SEED_ADMIN_TENANT=default

# ─── AUTH / JWT ───────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── OIDC / SSO (optional — leave blank to disable SSO) ──────────────────────
# When set, register https://your-domain.com/auth/oidc/callback in your IdP.
VITE_OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=https://your-domain.com/auth/oidc/callback
# For Google: leave the three below blank (defaults apply)
# For Azure AD / Okta / Auth0: set explicitly
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

# ─── FRONTEND / CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-domain.com
FRONTEND_URL=https://your-domain.com
VITE_API_URL=                           # Leave blank when nginx proxies /api/ on same origin

# ─── MULTI-TENANCY ────────────────────────────────────────────────────────────
MULTI_TENANT=true                       # false = single-tenant (all users share one data space)

# ─── TWILIO ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=                     # REQUIRED
TWILIO_AUTH_TOKEN=                      # REQUIRED — rotate immediately if leaked
TWILIO_API_KEY=
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=                      # REQUIRED
TWILIO_TWIML_APP_SID=
GATEWAY_PUBLIC_URL=

# ─── INTERNAL SERVICE URLS ────────────────────────────────────────────────────
ASR_SERVICE_URL=http://asr:5000
LLM_SERVICE_URL=http://llm:5001
TTS_SERVICE_URL=http://tts:5002
SOAP_SERVICE_URL=http://soap:5003
FHIR_SERVICE_URL=http://fhir:5004
ORCHESTRATOR_URL=http://orchestrator:5006
CLINICAL_LLM_URL=http://llm:5001
VA_LLM_URL=http://llm-va:5007

# ─── VOICE AGENT ──────────────────────────────────────────────────────────────
VA_MODEL=Qwen/Qwen2.5-3B-Instruct
VA_DEVICE=cpu
VA_DTYPE=float16
VA_MAX_CONCURRENCY=4
VOICE_AGENT_LLM_ENABLED=1

# ─── FHIR ─────────────────────────────────────────────────────────────────────
FHIR_BASE_URL=                          # REQUIRED
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_BEARER_TOKEN=
FHIR_BASIC_AUTH_USER=
FHIR_BASIC_AUTH_PASSWORD=

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── SOAP ASYNC QUEUE ─────────────────────────────────────────────────────────
SOAP_ASYNC_ENABLED=false
SOAP_QUEUE_URL=redis://redis:6379/0
SOAP_QUEUE_KEY=soap_jobs
SOAP_JOB_MAX_ATTEMPTS=3
SOAP_JOB_BACKOFF_MS=500

# ─── INTERNAL HTTP CLIENT ─────────────────────────────────────────────────────
INTERNAL_HTTP_TIMEOUT_MS=8000
INTERNAL_HTTP_RETRIES=2
INTERNAL_HTTP_CB_ENABLED=false
INTERNAL_HTTP_CB_THRESHOLD=5
INTERNAL_HTTP_CB_COOLDOWN_MS=30000

# ─── STREAMING ASR ────────────────────────────────────────────────────────────
STREAM_SILENCE_MS=1200
STREAM_SILENCE_RMS=300

# ─── ML / HUGGINGFACE ─────────────────────────────────────────────────────────
HUGGINGFACE_HUB_TOKEN=                  # Required for gated models; rotate if leaked

# ─── OBSERVABILITY ────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

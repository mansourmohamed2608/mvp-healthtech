# Runtime service configuration (do not commit real secrets)
# Use a secret manager (Vault/SSM/KMS) in prod and rotate regularly.
JWT_SECRET=
INTERNAL_SECRET=
WS_SHARED_SECRET=
TWILIO_AUTH_TOKEN=
ASR_SERVICE_URL=http://asr:5000
LLM_SERVICE_URL=http://llm:5001
TTS_SERVICE_URL=http://tts:5002
SOAP_SERVICE_URL=http://soap:5003
FHIR_SERVICE_URL=http://fhir:5004
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/healthtech
REDIS_HOST=redis
REDIS_PORT=6379
HUGGINGFACE_HUB_TOKEN=
FHIR_BASE_URL=https://fhir.example.com
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_BEARER_TOKEN=
FHIR_BASIC_AUTH_USER=
FHIR_BASIC_AUTH_PASSWORD=

# Internal HTTP client
INTERNAL_HTTP_TIMEOUT_MS=8000
INTERNAL_HTTP_RETRIES=2
INTERNAL_HTTP_CB_ENABLED=false
INTERNAL_HTTP_CB_THRESHOLD=5
INTERNAL_HTTP_CB_COOLDOWN_MS=30000

# Streaming ASR tuning
STREAM_SILENCE_MS=1200
STREAM_SILENCE_RMS=300

# SOAP async queue
SOAP_ASYNC_ENABLED=false
SOAP_QUEUE_URL=redis://redis:6379/0
SOAP_QUEUE_KEY=soap_jobs
SOAP_JOB_MAX_ATTEMPTS=3
SOAP_JOB_BACKOFF_MS=500

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Voice agent LLM toggle (1 default, 0 = canned TTS reply for audio testing)
VOICE_AGENT_LLM_ENABLED=1

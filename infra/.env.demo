# ====================================
# HEALTHTECH DEMO ENVIRONMENT CONFIG
# ====================================
# Copy to .env and fill in values

# ============ SECURITY SECRETS ============
# Generate with: openssl rand -base64 32
JWT_SECRET=GENERATE_ME_32_BYTES
INTERNAL_SECRET=GENERATE_ME_32_BYTES
POSTGRES_PASSWORD=GENERATE_ME_SECURE_PASSWORD

# ============ HUGGINGFACE ============
# Required for model downloads (large-v3, MMed-Llama)
# Get free token: https://huggingface.co/settings/tokens
HUGGINGFACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ============ TWILIO (Voice Agent) ============
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ FHIR (Optional for demo) ============
# Leave defaults for demo, or connect to real EHR
FHIR_BASE_URL=http://localhost:5004
FHIR_CLIENT_ID=demo
FHIR_CLIENT_SECRET=demo
FHIR_BEARER_TOKEN=

# ============ CORS ============
# Add your demo domain (or * for demo)
CORS_ALLOWED_ORIGINS=*

# ============ GRAFANA ============
GRAFANA_PASSWORD=demo123

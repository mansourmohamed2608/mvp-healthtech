# --- Node / pnpm ---
node_modules/
.pnpm-store/
**/.pnpm-store/
.pnp.*
.npm/
.cache/
dist/
build/
coverage/
.next/
out/

# keep lockfile!
!pnpm-lock.yaml

# --- Environment files (keep example only) ---
.env
.env.*.local
!.env.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.pid
*.seed
*.tsbuildinfo

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Python services (services/*) ---
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.venv/
**/venv/
**/env/
**/.ruff_cache/

# --- Docker ---
**/.docker/
**/docker-data/

# --- Data---
**/data/
**/kaggle_upload/

# --- Project-specific safety / outputs ---
